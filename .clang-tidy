Checks: "*,
        -abseil-*,
        -altera-*,
        -android-*,
        -fuchsia-*,
        -google-*,
        -llvm*,
        -zircon-*,
        -boost-use-ranges,
        -cppcoreguidelines-avoid-magic-numbers,
        -readability-magic-numbers,
        -portability-avoid-pragma-once,
        -cppcoreguidelines-avoid-const-or-ref-data-members"

WarningsAsErrors: ''
HeaderFilterRegex: '^${PROJECT_SOURCE_DIR}/(include|src|tests)'
FormatStyle:     none

CheckOptions:
  - key: readability-identifier-length.IgnoredVariableNames
    value: 'x|y|z|i|j|k|n|t|d|f|a|b|h'
  - key: readability-identifier-length.IgnoredParameterNames
    value: 'x|y|z|i|j|k|n|t|d|f|a|b|h'
  - key: modernize-use-auto.MinTypeNameLength
    value: '5'
  - key: modernize-use-auto.RemoveStars
    value: 'true'
  # `poet::static_for` lives in poet/core/static_for.hpp, but `core/*` is
  # explicitly non-public — the only sanctioned entry point is the
  # `<poet/poet.hpp>` umbrella. Tell include-cleaner not to flag it as
  # "not used directly".
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'poet/poet\.hpp'
