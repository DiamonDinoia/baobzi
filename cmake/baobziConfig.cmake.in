@PACKAGE_INIT@

# baobzi ships the C ABI as the installed package. The exported targets
# (`baobzi::baobzi_c` shared, `baobzi::baobzi_c_static` static) are
# self-contained — they only require the installed `baobzi.h` and carry no
# transitive find_dependency() (polyfit/POET are linked privately and are not
# part of the installed surface). Link your C/C++ application against either:
#
#   find_package(baobzi REQUIRED)
#   target_link_libraries(app PRIVATE baobzi::baobzi_c)
#
# The header-only C++ template API (`baobzi::baobzi`) is not installed; consume
# it in-tree via add_subdirectory()/FetchContent().

include("${CMAKE_CURRENT_LIST_DIR}/baobziTargets.cmake")

check_required_components(baobzi)
